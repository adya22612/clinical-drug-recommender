# Copy to .env and adjust. Never commit .env.
ENV=development

# --- Databases -------------------------------------------------------------
# Container-internal hostnames. When running scripts/ingest_data.py from the
# HOST, override with: MONGO_URI=mongodb://localhost:27017 CHROMA_HOST=localhost
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=clinical_db
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=drug_literature

# Must be identical in ingestion and in the MCP server
EMBED_MODEL=all-MiniLM-L6-v2

# --- Service endpoints -----------------------------------------------------
MCP_SERVER_URL=http://mcp_data_server:8000/sse
OLLAMA_BASE_URL=http://ollama:11434
ORCHESTRATOR_URL=http://orchestrator:8000

# --- Models ----------------------------------------------------------------
# Split roles: the small general model drives the ReAct loop, the medical
# model writes the clinical synthesis.
ORCHESTRATOR_MODEL=llama3.2:3b
CLINICAL_MODEL=biomistral
